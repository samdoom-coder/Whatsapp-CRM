# Database
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/whatsapp_crm?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
AUTH_SECRET=replace-with-a-long-random-secret-min-32-chars
PORT=4000
FRONTEND_URL=http://localhost:5173

# WhatsApp Cloud API (leave empty to run in demo mode)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=my-webhook-verify-token

# AI provider (mock | anthropic | openai)
AI_PROVIDER=mock
AI_API_KEY=

# Demo mode: simulate incoming WhatsApp traffic
DEMO_MODE=true
DEMO_MESSAGE_INTERVAL_MS=45000